{
  "name": "community-phone-device-images",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.5.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/**/*.test.mjs",
    "catalog:build": "node scripts/catalog/build.mjs",
    "catalog:validate": "node scripts/catalog/validate.mjs",
    "images:validate": "node scripts/images/validate.mjs",
    "verify": "pnpm catalog:validate && pnpm images:validate && pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "next": "15.5.21",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "@types/node": "22.15.21",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "eslint": "9.33.0",
    "eslint-config-next": "15.5.0",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.39.0"
  }
}
