{
  "name": "community-phone-device-images",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.5.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/**/*.test.mjs",
    "catalog:build": "node scripts/catalog/build.mjs",
    "catalog:import": "node scripts/catalog/import-kaggle.mjs",
    "catalog:validate": "node scripts/catalog/validate.mjs",
    "images:validate": "node scripts/images/validate.mjs",
    "verify": "pnpm catalog:validate && pnpm images:validate && pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "7.0.2"
  }
}
